### APPS ###
set $mod Mod4 # Windows key
set $alt Mod1 # Alt
set $term kitty
set $browser firefox
set $menu wofi --show drun  -i | xargs swaymsg exec --

# Open a web browser:
bindsym $mod+b exec $browser

# Open a terminal emulator:
bindsym $mod+t exec $term

# Kill focused window:
bindsym $mod+q kill

# Open the application launcher:
bindsym $mod+space exec $menu
